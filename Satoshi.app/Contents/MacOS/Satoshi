#!/bin/bash
# Launcher de Satoshi's Tool.
# Redirige stdout/stderr a /tmp/satoshi-tool.log para diagnosticar fallos
# al lanzar desde Finder (que no muestra terminal).

LOG="/tmp/satoshi-tool.log"
{
echo "=== Satoshi launcher start: $(date) ==="
echo "PATH=$PATH"
echo "PWD inicial: $(pwd)"
echo "BASH_SOURCE: $0"

# Directorio que contiene el .app
APP_PARENT="$(cd "$(dirname "$0")/../../.." && pwd)"
FALLBACK="/Users/boris/Desktop/Programación/Bitcoin"

echo "APP_PARENT: $APP_PARENT"

if [ -f "$APP_PARENT/Satoshi_Tool.py" ]; then
    PROJECT_DIR="$APP_PARENT"
elif [ -f "$FALLBACK/Satoshi_Tool.py" ]; then
    PROJECT_DIR="$FALLBACK"
else
    /usr/bin/osascript -e 'display alert "Satoshi'\''s Tool" message "No encuentro Satoshi_Tool.py. Mira /tmp/satoshi-tool.log para más detalle."'
    echo "FATAL: no encontré Satoshi_Tool.py ni en $APP_PARENT ni en $FALLBACK"
    exit 1
fi

echo "PROJECT_DIR: $PROJECT_DIR"
cd "$PROJECT_DIR"

echo "python3 path: $(which python3)"
echo "python3 version: $(python3 --version 2>&1)"
echo "=== launching Satoshi_Tool.py ==="

exec /usr/bin/env python3 Satoshi_Tool.py
} >> "$LOG" 2>&1
